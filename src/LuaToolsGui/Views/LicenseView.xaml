<UserControl
    x:Class="LuaToolsGui.Views.LicenseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:LicenseViewModel}"
    xmlns:local="clr-namespace:LuaToolsGui"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <Grid>
        <!-- Layer 1: Blurred background -->
        <Border>
            <Border.Effect>
                <BlurEffect KernelType="Gaussian" Radius="32" RenderingBias="Performance" />
            </Border.Effect>
            <Grid Background="#F5F0E8" />
        </Border>

        <!-- Layer 2: Semi-transparent dark overlay -->
        <Border Background="#33000000" />

        <!-- Layer 3: License card (sharp, no blur) -->
        <Border
            MaxWidth="440"
            Margin="16"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFDF8"
            BorderBrush="#4D2D2A26"
            BorderThickness="1"
            CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.18" ShadowDepth="0" Color="#1C1A17" />
            </Border.Effect>

            <StackPanel Margin="32,36,32,32">
                <!-- App icon -->
                <ui:ImageIcon
                    Source="pack://application:,,,/icon.ico"
                    Height="48"
                    Width="48"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16" />

                <!-- Title -->
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#1C1A17"
                    HorizontalAlignment="Center"
                    Text="GalapaSteam"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="13"
                    Foreground="#6B6560"
                    HorizontalAlignment="Center"
                    Text="Ingresa tu clave de licencia para activar"
                    TextWrapping="Wrap" />

                <!-- Key input -->
                <Border
                    Margin="0,24,0,0"
                    Padding="14,12"
                    Background="#F5F0E8"
                    BorderBrush="#4D2D2A26"
                    BorderThickness="1"
                    CornerRadius="10">
                    <TextBox
                        x:Name="KeyBox"
                        Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="18"
                        FontFamily="Consolas"
                        FontWeight="SemiBold"
                        Foreground="#1C1A17"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        MaxLength="22" />
                </Border>

                <!-- Error message -->
                <Border
                    Margin="0,12,0,0"
                    Padding="12,10"
                    Background="#FFF0F0"
                    BorderBrush="#4Ddc2626"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock
                        FontSize="12"
                        Foreground="#c0392b"
                        Text="{Binding Error}"
                        TextWrapping="Wrap" />
                </Border>

                <!-- Success message -->
                <Border
                    Margin="0,12,0,0"
                    Padding="12,10"
                    Background="#F0FFF4"
                    BorderBrush="#4D22c55e"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock
                        FontSize="12"
                        Foreground="#16a34a"
                        Text="{Binding SuccessMessage}"
                        TextWrapping="Wrap" />
                </Border>

                <!-- Activate button -->
                <ui:Button
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding ValidateCommand}"
                    IsEnabled="{Binding IsValidating, Converter={StaticResource InverseBoolToVis}}"
                    Content="Activar licencia"
                    Icon="{ui:SymbolIcon Checkmark24}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Height="40" />

                <!-- Loading indicator -->
                <StackPanel
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsValidating, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing
                        Width="16"
                        Height="16"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#6B6560"
                        Text="Validando licencia..." />
                </StackPanel>

                <!-- Footer hint -->
                <TextBlock
                    Margin="0,16,0,0"
                    FontSize="11"
                    Foreground="#9CA3AF"
                    HorizontalAlignment="Center"
                    Text="Contacta al administrador si no tienes una clave"
                    TextWrapping="Wrap" />

                <!-- HWID display -->
                <Border
                    Margin="0,10,0,0"
                    Padding="10,8"
                    Background="#F5F0E8"
                    BorderBrush="#4D2D2A26"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock
                            FontSize="10"
                            Foreground="#9CA3AF"
                            HorizontalAlignment="Center"
                            Text="ID de tu PC (comparte con el admin si es necesario)" />
                        <TextBlock
                            FontSize="11"
                            FontFamily="Consolas"
                            Foreground="#6B6560"
                            HorizontalAlignment="Center"
                            Text="{Binding Hwid}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
